<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>0.8.0</Version>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <FileVersion>0.8.0.0</FileVersion>
    <InformationalVersion>0.8.0 - Model information display and selection fixes</InformationalVersion>

    <ApplicationIcon>OllamaIcon.ico</ApplicationIcon>
    <Win32Icon>OllamaIcon.ico</Win32Icon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Data\Database.cs" />
    <Compile Include="Data\ModelInformationDatabase.cs" />
    <Compile Include="Models\ManifestDocument.cs" />
    <Compile Include="Models\ModelInfo.cs" />
    <Compile Include="Models\ModelInformation.cs" />
    <Compile Include="Services\AppLogger.cs" />
    <Compile Include="Services\CategoryService.cs" />
    <Compile Include="Services\OllamaOnlineCatalogService.cs" />
    <Compile Include="Services\ModelInformationUpdateService.cs" />
    <Compile Include="Services\ModelInformationSelectionFeature.cs" />
    <Compile Include="Services\NetworkAccessPolicyFeature.cs" />
    <Compile Include="Services\OllamaScanner.cs" />
    <Compile Include="Services\RamEstimator.cs" />
    <Compile Include="Services\DeleteModelFeature.cs" />
    <Compile Include="Services\RamColumnFeature.cs" />
    <Compile Include="UI\LogForm.cs" />
    <Compile Include="UI\MainForm.cs" />
    <Compile Include="UI\MainFormOnline.cs" />
    <Compile Include="UI\ModelInformationForm.cs" />
    <Compile Include="UI\ModelInformationUpdateForm.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="OllamaIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

</Project>
